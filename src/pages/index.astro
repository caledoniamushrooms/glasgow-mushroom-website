---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'hello@glasgowmushroom.co';
---

<BaseLayout
  title="Glasgow Mushroom Company"
  description={`Glasgow Mushroom Company has closed. For equipment and environmental control consultancy, contact ${email}.`}
  showNav={false}
  showFooter={false}
>
  <section class="placeholder">
    <div class="placeholder__inner">
      <img src="/images/logo-full.svg" alt="Glasgow Mushroom Company" width="144" height="60" class="placeholder__logo" />
      <h1>Glasgow Mushroom Company</h1>
      <p class="lede">The farm has now closed. Thank you to everyone who grew with us.</p>
      <p class="enquiries">Equipment and environmental control consultancy</p>
      <a href={`mailto:${email}`} class="btn">{email}</a>
    </div>
    <a href="/privacy-policy" class="small">Privacy policy</a>
  </section>
</BaseLayout>

<style>
  .placeholder {
    min-height: 100vh; min-height: 100dvh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 3rem var(--container-padding) 2rem; text-align: center;
  }
  .placeholder__inner { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; max-width: 36rem; }
  .placeholder__logo { width: 144px; height: auto; display: block; filter: invert(1); margin-bottom: 2.5rem; }
  h1 { font-family: var(--font-heading); color: var(--color-text); font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.05; margin: 0; }
  p { color: var(--color-text-muted); line-height: 1.55; margin: 0; }
  .lede { font-size: 1.15rem; margin: 1.25rem 0 2.5rem; }
  .enquiries { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 1rem; }
  .btn {
    display: inline-block; font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700;
    padding: 0.7rem 1.4rem; border-radius: 6px; text-decoration: none; color: #fff;
    border: 1px solid #555; transition: background-color 0.2s ease; overflow-wrap: anywhere;
  }
  .btn:hover { background: #1a1a1a; }
  .small { font-size: 0.8rem; color: var(--color-text-muted); text-decoration: underline; margin-top: 2rem; }
</style>
